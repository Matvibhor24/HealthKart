<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EBF9FF"
    tools:context=".DoctorHomeScreen">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#195A80"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="25dp"
            android:text="Dr. [Doctor's Name]"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/kinetica_bold" />

        <ImageView
            android:id="@+id/profile_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/doctor_profile_pic"
            android:contentDescription="Profile" />
    </LinearLayout>

    <!-- ScrollView for the content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/topBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Patient Queue Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Patient Queue"
                android:textSize="20sp"
                android:fontFamily="@font/noyhslimr_bold"
                android:textColor="#195A80" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/patient_queue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <!-- Appointment Management Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appointments"
                android:textSize="20sp"
                android:fontFamily="@font/noyhslimr_bold"
                android:textColor="#195A80"
                android:layout_marginTop="16dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/appointments_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <!-- Communication Tools -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Communication Tools"
                android:textSize="20sp"
                android:fontFamily="@font/noyhslimr_bold"
                android:textColor="#195A80"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/chat_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chat"
                    android:background="@drawable/button_background"
                    android:textColor="#FFFFFF"
                    android:padding="16dp"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/video_call_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Video Call"
                    android:background="@drawable/button_background"
                    android:textColor="#FFFFFF"
                    android:padding="16dp"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Prescription and Medical Records -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prescriptions and Records"
                android:textSize="20sp"
                android:fontFamily="@font/noyhslimr_bold"
                android:textColor="#195A80"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/issue_prescription_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Issue Prescription"
                android:background="@drawable/button_background"
                android:textColor="#FFFFFF"
                android:padding="16dp"
                android:layout_marginTop="8dp"
                android:textSize="16sp" />

            <Button
                android:id="@+id/view_records_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="View Medical Records"
                android:background="@drawable/button_background"
                android:textColor="#FFFFFF"
                android:padding="16dp"
                android:layout_marginTop="8dp"
                android:textSize="16sp" />

            <!-- Profile Management -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile Management"
                android:textSize="20sp"
                android:fontFamily="@font/noyhslimr_bold"
                android:textColor="#195A80"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/edit_profile_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Edit Profile"
                android:background="@drawable/button_background"
                android:textColor="#FFFFFF"
                android:padding="16dp"
                android:layout_marginTop="8dp"
                android:textSize="16sp" />

            <!-- Billing and Payments -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Billing and Payments"
                android:textSize="20sp"
                android:fontFamily="@font/noyhslimr_bold"
                android:textColor="#195A80"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/view_billing_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="View Billing Information"
                android:background="@drawable/button_background"
                android:textColor="#FFFFFF"
                android:padding="16dp"
                android:layout_marginTop="8dp"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
